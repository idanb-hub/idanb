from __future__ import annotations

import sys
from pathlib import Path

from IPython.core.getipython import get_ipython

from idanb import widgets

# Find `download.ipy` script in source directory.
file = sys.modules[widgets.Download.__module__].__file__
assert file is not None
path = Path(file).with_suffix(".ipy")
assert path.is_file()

# Run the script.
ip = get_ipython()
assert ip is not None
ip.run_line_magic("run", str(path))
